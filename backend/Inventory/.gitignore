# --- Python / Flask ---
__pycache__/
*.py[cod]
*$py.class
.env
.flaskenv
instance/
.pytest_cache/
htmlcov/
.coverage

# --- SQLAlchemy / Database ---
# Ignore local SQLite databases
*.db
*.sqlite
*.sqlite3

# --- Flask-Migrate / Alembic ---
# Keep the migrations directory and Python files, but ignore compiled files
migrations/__pycache__/
migrations/*.pyc

# --- Virtual Environments ---
.venv/
venv/
env/
ENV/

# --- IDEs / Editors ---
.vscode/
.idea/
*.swp
*.swo

# --- OS Generated ---
.DS_Store
Thumbs.db
