# ./flask_project/Dockerfile
FROM python:3.13-slim as base_image

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN mkdir /app

WORKDIR /app

# build-essential + mysqlclient dev headers needed for grpcio and SQLAlchemy MySQL
RUN apt-get update && apt-get install -y \
    gcc \
    python3-dev \
    pkg-config \
    default-libmysqlclient-dev \
    && rm -rf /var/lib/apt/lists/**

COPY ../requirements.txt /app/requirements.txt
RUN pip install --upgrade pip && pip install -r requirements.txt

COPY . /app/

# flask port -> no use
EXPOSE 5000
# gRPC server port
EXPOSE 50051

# migrations
RUN flask db upgrade
# app.py uses `if __name__ == "__main__"`, so must be launched as a script
CMD ["python", "app.py"]





