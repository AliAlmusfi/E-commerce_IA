FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc \
        python3-dev \
        pkg-config \
        default-libmysqlclient-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Context is root, so we can copy requirements directly!
COPY requirements.txt .
RUN pip install --upgrade pip && pip install -r requirements.txt

# Copy Django app from backend/src
COPY src/ /app/

# Copy entrypoint (Make sure it exists at backend/src/docker/entrypoint.sh)
COPY src/docker/entrypoint.sh /app/docker/entrypoint.sh
RUN chmod +x /app/docker/entrypoint.sh

EXPOSE 8000

ENTRYPOINT ["/app/docker/entrypoint.sh"]